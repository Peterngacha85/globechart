# ---------- Server ----------
PORT=5000
NODE_ENV=development
# Comma-separated list of allowed browser origins (REST + Socket.io)
CORS_ORIGIN=http://localhost:5173
# Public URL of the frontend (used in referral links and password-reset links)
FRONTEND_URL=http://localhost:5173

# ---------- Database ----------
# Atlas: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=
# Database name used when the URI does not include one
MONGODB_DB=globechart

# ---------- Auth ----------
# At least 32 characters. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Optional; derived from JWT_SECRET when empty
JWT_REFRESH_SECRET=
JWT_EXPIRE=7d
REFRESH_TOKEN_EXPIRE=30d

# ---------- Admin account (source of truth) ----------
# On every server start the backend makes the admin account in the database match these values.
# Change a value here and restart: the same admin is renamed / gets the new password. Nothing is seeded.
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@globechart.com
ADMIN_PHONE=0700000000
# Wrap the password in double quotes if it contains a # (an unquoted # starts a comment and cuts the password short)
ADMIN_PASSWORD=

# ---------- M-Pesa (Daraja) ----------
# simulate = no network calls, payments auto-complete (development only, refused in production)
# sandbox  = Safaricom sandbox, needs the keys below
# live     = production Daraja
# manual   = no Daraja: users Send Money to MANUAL_PAY_NUMBER and enter the M-Pesa code; an admin confirms it
MPESA_MODE=simulate
MANUAL_PAY_NUMBER=
MANUAL_PAY_NAME=
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
# Must be publicly reachable by Safaricom (e.g. an ngrok URL) + /api/finance/mpesa/callback
MPESA_CALLBACK_URL=

# ---------- Email (stubbed until SMTP is available) ----------
# Without SMTP settings, emails (e.g. password reset links) are printed to the server console.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=Globechart <no-reply@globechart.com>

# ---------- Launch ----------
# ON  = everyone except the admin sees the Coming Soon page; members cannot sign up, sign in or use the app.
#       The admin still signs in at /admin/login to set things up.
# OFF = the site is open (default). Restart the backend after changing it (Render restarts automatically).
COMING_SOON=OFF
# Optional: adds a countdown to the Coming Soon page. Include the timezone, e.g. 2026-11-01T09:00:00+03:00
LAUNCH_DATE=
